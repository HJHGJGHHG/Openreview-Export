{
  "manifest_version": 3,
  "name": "OpenReview Export",
  "version": "1.2.0",
  "description": "Export OpenReview forums to Markdown or a ZIP with papers and attachments.",
  "host_permissions": ["https://openreview.net/*", "https://www.openreview.net/*"],
  "content_scripts": [
    {
      "matches": [
        "https://openreview.net/*",
        "https://www.openreview.net/*"
      ],
      "js": [
        "content/constants.js",
        "content/helpers.js",
        "content/math.js",
        "content/review-parser.js",
        "vendor/fflate-0.8.2.js",
        "content/forum.js",
        "content/archive.js",
        "content/ui.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["logo/Markdown-mark.svg"],
      "matches": ["https://openreview.net/*", "https://www.openreview.net/*"]
    }
  ],
  "action": {
    "default_title": "Export forum and materials"
  }
}
